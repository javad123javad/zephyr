#include <st/n6/stm32n657X0.dtsi>
#include <st/n6/stm32n657x0hxq-pinctrl.dtsi>
#include <zephyr/dt-bindings/flash_controller/xspi.h>
#include <zephyr/dt-bindings/gpio/raspberrypi-csi-connector.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	chosen {
		zephyr,console = &usart1;
		zephyr,shell-uart = &usart1;
		zephyr,sram = &axisram2;
		zephyr,canbus = &fdcan1;
		spi-flash0 = &w25q64jv;
		zephyr,flash-controller = &w25q64jv;
		zephyr,flash = &ext_flash;
		zephyr,code-partition = &slot0_partition;
		mcuboot,image-ram = &axisram1;
	};

	leds: leds {
		compatible = "gpio-leds";

		green_led: led_1 {
			gpios = <&gpioa 1 GPIO_ACTIVE_LOW>;
			label = "User LD6";
		};

		blue_led: led_2 {
			gpios = <&gpioa 4 GPIO_ACTIVE_LOW>;
			label = "User LD7";
		};

		red_led: led_3 {
			gpios = <&gpioa 2 GPIO_ACTIVE_LOW>;
			label = "User LD5";
		};
	};

	aliases {
		led0 = &green_led;
		led1 = &blue_led;
		led2 = &red_led;
		rtc = &rtc;
		watchdog0 = &iwdg;
	};
};

&clk_hse {
	hse-div2;
	clock-frequency = <DT_FREQ_M(48)>;
	status = "okay";
};

&clk_hsi {
	hsi-div = <1>;
	status = "okay";
};

&clk_lse {
	status = "disabled";
};

&pll1 {
	clocks = <&clk_hse>;
	div-m = <3>;
	mul-n = <150>;
	div-p1 = <1>;
	div-p2 = <1>;
	status = "okay";
};

&pll3 {
	clocks = <&clk_hse>;
	div-m = <3>;
	mul-n = <125>;
	div-p1 = <1>;
	div-p2 = <1>;
	status = "okay";
};

&ic1 {
	pll-src = <1>;
	ic-div = <3>;
	status = "okay";
};

&ic2 {
	pll-src = <1>;
	ic-div = <6>;
	status = "okay";
};

&ic6 {
	pll-src = <3>;
	ic-div = <2>;
	status = "okay";
};

&ic11 {
	pll-src = <1>;
	ic-div = <3>;
	status = "okay";
};

&ic17 {
	pll-src = <1>;
	ic-div = <4>;
	status = "okay";
};

/* IC18 must be enabled for the 27MHz CSIPHY */
&ic18 {
	pll-src = <1>;
	ic-div = <60>;
	status = "okay";
};

&perck {
	clocks = <&rcc STM32_SRC_HSI PER_SEL(0)>;
	status = "okay";
};

&cpusw {
	clocks = <&rcc STM32_SRC_IC1 CPU_SEL(3)>;
	clock-frequency = <DT_FREQ_M(800)>;
	status = "okay";
};

&rcc {
	/* ic2, ic6 & ic11 must all be enabled to set ic2 as SYSCLK */
	clocks = <&ic2>;
	clock-frequency = <DT_FREQ_M(400)>;
	ahb-prescaler = <2>;
	timg-prescaler = <2>;
};

io_cnf_i2c:&i2c1 {
	clocks = <&rcc STM32_CLOCK(APB1, 21)>,
		 <&rcc STM32_SRC_CKPER I2C1_SEL(1)>;
	pinctrl-0 = <&i2c1_scl_ph9 &i2c1_sda_pc1>;
	pinctrl-names = "default";
	scl-gpios = <&gpioh 9 GPIO_ACTIVE_HIGH>;
	sda-gpios = <&gpioc 1 GPIO_ACTIVE_HIGH>;
	clock-frequency = <I2C_BITRATE_STANDARD>;
	status = "okay";
};

io_i2c: &i2c2 {
	clocks = <&rcc STM32_CLOCK(APB1, 22)>,
		 <&rcc STM32_SRC_CKPER I2C2_SEL(1)>;
	pinctrl-0 = <&i2c2_scl_pd14 &i2c2_sda_pd15>;
	pinctrl-names = "default";
	scl-gpios = <&gpiod 14 GPIO_ACTIVE_HIGH>;
	sda-gpios = <&gpiod 15 GPIO_ACTIVE_HIGH>;
	clock-frequency = <I2C_BITRATE_STANDARD>;
	status = "okay";
};

io_spi:&spi2 {
	clocks = <&rcc STM32_CLOCK(APB1, 14)>,
		 <&rcc STM32_SRC_CKPER SPI2_SEL(1)>;
	/* IO_SPI_CS0 (PA11) is a GPIO driven by the I/O card SPI port slots */
	pinctrl-0 = <&spi2_sck_pf2 &spi2_miso_pd6 &spi2_mosi_pd2>;
	pinctrl-names = "default";
	status = "okay";
};

io_i2s:&i2s1 {
        clocks = <&rcc STM32_CLOCK(APB2, 12)>,
                 <&rcc STM32_SRC_CKPER SPI1_SEL(1)>;
        pinctrl-0 = <&i2s1_ws_pa15 &i2s1_sdo_pb5 &i2s1_sdi_pb8 &i2s1_ck_pb9>;
        pinctrl-names = "default";
        status = "okay";
};

io_debug:&usart1 {
	clocks = <&rcc STM32_CLOCK(APB2, 4)>,
		 <&rcc STM32_SRC_CKPER USART1_SEL(1)>;
	pinctrl-0 = <&usart1_tx_pe5 &usart1_rx_pe6>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

io_rs485: &usart3 {
	clocks = <&rcc STM32_CLOCK(APB1, 18)>,
		 <&rcc STM32_SRC_CKPER USART3_SEL(1)>;
	pinctrl-0 = <&usart3_tx_pb10 &usart3_rx_pb11 &usart3_de_pg2>;
	pinctrl-names = "default";
	current-speed = <115200>;
	de-enable;
	status = "okay";
};

io_uart:&usart2 {
        clocks = <&rcc STM32_CLOCK(APB1, 17)>,
                 <&rcc STM32_SRC_CKPER USART2_SEL(1)>;
        pinctrl-0 = <&usart2_tx_pg3 &usart2_rx_pf6>;
        pinctrl-names = "default";
        current-speed = <115200>;
        status = "okay";
};

io_rs485_uart:&usart3 {
	clocks = <&rcc STM32_CLOCK(APB1, 18)>,
		 <&rcc STM32_SRC_CKPER USART3_SEL(1)>;
	pinctrl-0 = <&usart3_tx_pb10 &usart3_rx_pb11  &usart3_de_pg2>;
	pinctrl-names = "default";
	current-speed = <115200>;
	de-enable;
	status = "okay";
};

esp_wifi_uart:&usart6 {
        clocks = <&rcc STM32_CLOCK(APB2, 5)>,
                 <&rcc STM32_SRC_CKPER USART6_SEL(1)>;
        pinctrl-0 = <&usart6_tx_pc6 &usart6_rx_pc7 &usart6_cts_pb13 &usart6_rts_pb15>;
	        pinctrl-names = "default";
        current-speed = <115200>;
        status = "okay";

	esp_wifi: esp-wifi {
        	compatible = "espressif,esp-at";
        //power-gpios = <&gpio0 18 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
        	status = "okay";
    	};

};

zephyr_udc0: &usbotg_hs1 {
	status = "okay";
};

zephyr_udc1: &usbotg_hs2 {
        status = "okay";
};

&mac {
	status = "okay";
	pinctrl-0 = <&eth1_rmii_ref_clk_pf7
		     &eth1_rmii_crs_dv_pf10
		     &eth1_rmii_rxd0_pf14
		     &eth1_rmii_rxd1_pf15
		     &eth1_rmii_tx_en_pf11
		     &eth1_rmii_txd0_pf12
		     &eth1_rmii_txd1_pf13>;
	pinctrl-names = "default";
	phy-connection-type = "rmii";
	phy-handle = <&eth_phy>;
	/*
	 * An area of OTP is dedicated to holding Ethernet MAC addresses;
	 * however, it is not programmed during manufacturing. Reading an
	 * unprogrammed OTP returns all zeroes, which breaks Ethernet if used
	 * as MAC address. To allow the use of Ethernet even on virgin boards,
	 * we do not define the nvmem-cell properties below (commented out)
	 * so that default MAC address source is not the OTP memory.
	 *
	 * Once a MAC address has been programmed in OTP, you can enable
	 * its use by uncommenting the following properties:
	 */
	/* nvmem-cells = <&mac_address0>; */
	/* nvmem-cell-names = "mac-address"; */
};

&mdio {
	status = "okay";
	pinctrl-0 = <&eth1_mdio_pd12 &eth1_mdc_pd1>;
	pinctrl-names = "default";

	eth_phy: ethernet-phy@0 {
		compatible = "ethernet-phy";
		reg = <0x0>;
	};
};

&xspi2 {
	pinctrl-0 = <&xspim_p2_ncs1_pn1 &xspim_p2_clk_pn6
		     &xspim_p2_io0_pn2 &xspim_p2_io1_pn3 &xspim_p2_io2_pn4
		     &xspim_p2_io3_pn5>;
	pinctrl-names = "default";
	status = "okay";

	w25q64jv: qspi-nor-flash@0 {
		compatible = "st,stm32-xspi-nor";
		reg = <0>;
		size = <DT_SIZE_M(64)>; /* 64 Mbits */
		ospi-max-frequency = <DT_FREQ_M(50)>;
		spi-bus-width = <XSPI_QUAD_MODE>;
		data-rate = <XSPI_STR_TRANSFER>;
		status = "okay";

		/* XSPI external flash mapping */
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x70000000 DT_SIZE_M(8)>;

		ext_flash: ext-flash@0 {
			compatible = "soc-nv-flash";
			reg = <0x0 DT_SIZE_M(8)>;
			write-block-size = <1>;
			erase-block-size = <DT_SIZE_K(4)>;
			#address-cells = <1>;
			#size-cells = <1>;
			ranges;

			partitions {
				#address-cells = <1>;
				#size-cells = <1>;
				ranges;

				boot_partition: partition@0 {
					compatible = "zephyr,mapped-partition";
					label = "mcuboot";
					reg = <0x00000000 DT_SIZE_K(64)>;
				};

				slot0_partition: partition@10000 {
					compatible = "zephyr,mapped-partition";
					label = "image-0";
					reg = <0x00010000 DT_SIZE_K(4032)>;
				};

				slot1_partition: partition@400000 {
					compatible = "zephyr,mapped-partition";
					label = "image-1";
					reg = <0x00400000 DT_SIZE_K(4032)>;
				};

				storage_partition: partition@7f0000 {
					compatible = "zephyr,mapped-partition";
					label = "storage";
					reg = <0x007f0000 DT_SIZE_K(64)>;
				};
			};
		};
	};
};

&bsec {
	/* Required by "iocell" and "ethernet" drivers */
	status = "okay";
};

&rng {
	status = "okay";
};

&iwdg {
	status = "okay";
};

&rtc {
	clocks = <&rcc STM32_CLOCK(APB4, 16)>,
		 <&rcc STM32_SRC_LSE RTC_SEL(1)>;
	status = "disabled";
};

/* DIN41612 I/O card connector (see the mind_io module) */
/ {
	mio_gpios: connector-gpios {
		compatible = "mind,din41612-gpios";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <0 0 &gpiod 11 0>,	/* IO_GPIO0 */
			   <1 0 &gpioe 0 0>,	/* IO_GPIO1 */
			   <2 0 &gpiob 2 0>,	/* IO_GPIO2 */
			   <3 0 &gpiob 3 0>;	/* IO_GPIO3 */
	};

	mio_connector: connector {
		compatible = "mind,din41612-io";
		i2c-cnf = <&i2c1>;
		i2c-io = <&i2c2>;
		spi = <&spi2>;
		uart = <&usart2>;
		rs485 = <&usart3>;
		i2s = <&i2s1>;
		spi-cs0-gpios = <&gpioa 11 GPIO_ACTIVE_HIGH>;
		fault-led-gpios = <&gpiod 5 GPIO_ACTIVE_HIGH>;
		io-gpios = <&mio_gpios 0 0>, <&mio_gpios 1 0>, <&mio_gpios 2 0>, <&mio_gpios 3 0>;

		mio_i2c_port0: i2c-port-0 {
			compatible = "mind,io-i2c-port";
			slot = <0>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		mio_i2c_port1: i2c-port-1 {
			compatible = "mind,io-i2c-port";
			slot = <1>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		mio_i2c_port2: i2c-port-2 {
			compatible = "mind,io-i2c-port";
			slot = <2>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		mio_i2c_port3: i2c-port-3 {
			compatible = "mind,io-i2c-port";
			slot = <3>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		mio_spi_port0: spi-port-0 {
			compatible = "mind,io-spi-port";
			slot = <0>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		mio_spi_port1: spi-port-1 {
			compatible = "mind,io-spi-port";
			slot = <1>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		mio_spi_port2: spi-port-2 {
			compatible = "mind,io-spi-port";
			slot = <2>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		mio_spi_port3: spi-port-3 {
			compatible = "mind,io-spi-port";
			slot = <3>;
			#address-cells = <1>;
			#size-cells = <0>;
		};
	};
};
