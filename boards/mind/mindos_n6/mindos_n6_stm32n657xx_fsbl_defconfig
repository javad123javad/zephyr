# Enable UART driver
CONFIG_SERIAL=y

# Enable GPIO for hogs
CONFIG_GPIO=y

# Console
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# Enable MPU
CONFIG_ARM_MPU=y

# Enable HW stack protection
CONFIG_HW_STACK_PROTECTION=y

# Loaded into internal RAM by the boot ROM
CONFIG_XIP=n

# HAL needs TRUSTED_EXECUTION_SECURE explicitly enabled
CONFIG_TRUSTED_EXECUTION_SECURE=y
