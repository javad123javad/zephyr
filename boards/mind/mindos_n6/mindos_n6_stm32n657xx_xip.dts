/dts-v1/;
#include "mindos_n6_common.dtsi"

/ {
	model = "MindOS STM32N657L0 MCU board (XIP application)";
	compatible = "st,stm32n657x0-mindos-xip";

	chosen {
		/* MCUboot-booted application: executes XIP from external flash,
		 * uses the larger AXISRAM1 region for RAM (data/bss/heap/stack).
		 */
		zephyr,sram = &axisram1;
	};
};
